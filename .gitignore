*.pyc
.venv/
venv/

# 构建/校验过程产生的临时文件
site_build/*.png
site_build/_*.html
site_build/kb_data.json
dist/

# 系统与编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# 本地个人配置（如以后加）
*.local.*
.env

# 本地分发用的单文件（仓库里用 index.html 部署）
测试开发知识库.html

